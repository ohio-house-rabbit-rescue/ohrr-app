# Copy to android/keystore.properties (gitignored) to sign release builds.
# The TEST keystore + its passwords live OUTSIDE the repo:
#   G:\Shared drives\07-OHRR App\Mobile builds\keys\  (README.txt has the values)
# Paths can be absolute; backslashes must be doubled or use forward slashes.
storeFile=G:/Shared drives/07-OHRR App/Mobile builds/keys/ohrr-test.keystore
storePassword=CHANGE-ME
keyAlias=ohrr-test
keyPassword=CHANGE-ME
