# Public, browser-safe Supabase config for the DEPLOYED build (Netlify reads this
# at build time). These are the PUBLIC project URL + the *publishable* (anon) key.
# Supabase designs the publishable key (sb_publishable_...) to be exposed in the
# browser, so it is safe to commit — the real security boundary is Row-Level
# Security in the database, not key secrecy.
#
# NEVER put the service_role / secret key (sb_secret_...) or the DB password here
# or anywhere in the repo. Those are server-only.
#
# Local development can override these via .env.local (gitignored).
VITE_SUPABASE_URL=https://ixxzebtzjgeimoijexwn.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable__Yc7IquvYLVFdgqfcXfvmw_vN_bEIyO
