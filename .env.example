# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — secrets must NEVER be committed.
#
# These are NOT needed for the current read-only v1. They become relevant once
# we add dynamic features (e.g. event registration, live schedule, saved favorites).

# --- Supabase (public, browser-safe) ---
# Anything prefixed with VITE_ is bundled into the browser. Only put PUBLIC keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only secrets (do NOT put these here) ---
# The Supabase service_role key and database password are admin credentials.
# Never expose them to the browser. Store them in Netlify's environment-variable
# settings (Site settings -> Environment variables) for any server/build use only.
