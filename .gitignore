# dependencies
node_modules/

# build output
dist/
dist-ssr/

# vite cache
.vite/

# local env files — NEVER commit secrets
.env
.env.local
.env.*.local

# logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# misc
*.local

# local Claude Code dev config
.claude/

# Capacitor native builds (the android/ and ios/ projects ARE committed;
# each has its own .gitignore for build/, .gradle/, Pods/, DerivedData/ etc.)
*.keystore
*.jks
*.p12
*.mobileprovision
android/local.properties
android/app/release/
android/app/debug/
ios/App/App/public/
ios/App/build/
ios/App/Pods/
ios/App/DerivedData/
